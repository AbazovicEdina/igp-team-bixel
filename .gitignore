# Unity project .gitignore
# Place this file in the root folder of the Unity project.
#
# Based on GitHub's official Unity .gitignore:
# https://github.com/github/gitignore/blob/main/Unity.gitignore

# =========================
# Unity generated folders
# =========================

.utmp/
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# =========================
# Logs and crash files
# =========================

*.log
sysinfo.txt
mono_crash.*

# =========================
# Unity memory captures and recordings
# =========================

/[Mm]emoryCaptures/
/[Rr]ecordings/

# =========================
# Blender temporary files
# =========================
# Unity can import .blend files, but .blend1 files are only Blender backups.

*.blend1
*.blend1.meta

# =========================
# Asset Store tools
# =========================
# Uncomment this if Asset Store Tools should not be versioned.
# /[Aa]ssets/AssetStoreTools*

# =========================
# IDE and editor files
# =========================

# Visual Studio local cache
.vs/

# JetBrains Rider generated Unity plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# JetBrains Rider personal settings
*.DotSettings.user

# VS Code local cache files
.vscode/.browse.c_cpp.db*
.vscode/ipch/
.history/

# Consulo / MonoDevelop / generated IDE files
ExportedObj/
.consulo/

# Autogenerated solution and project files
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.VC.VC.opendb

# Keep Visual Studio configuration files trackable
!.vsconfig

# =========================
# Unity generated meta/debug files
# =========================

*.pidb.meta
*.pdb.meta
*.mdb.meta

# =========================
# Build outputs and packages
# =========================

*.apk
*.aab
*.unitypackage
*.unitypackage.meta
*.app

# =========================
# Android / Gradle cache
# =========================

.gradle/
local.properties

# =========================
# Crashlytics
# =========================

crashlytics-build.properties

# =========================
# Unity Test Runner
# =========================

InitTestScene*.unity*
/[Aa]ssets/[Ii]nit[Tt]est[Ss]cene*.unity*

# =========================
# Addressables generated files
# =========================

/ServerData
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# =========================
# Unity Visual Scripting generated files
# =========================

/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Flow/UnitOptions.db.meta
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers
/[Aa]ssets/Unity.VisualScripting.Generated/VisualScripting.Core/Property Providers.meta

# =========================
# Unity generated asset cache
# =========================

/[Aa]ssets/[Ss]ceneDependencyCache*

# =========================
# Operating system files
# =========================

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd

# Windows
Thumbs.db
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
*~
.directory
.Trash-*
.nfs*

# =========================
# Local environment files
# =========================

.env
.env.*
!.env.example